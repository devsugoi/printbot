<?xml version="1.0" encoding="UTF-8"?>
<oor:items xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- Inch-based layout (Letter/Legal bond paper). Value 8 = inches. -->
  <item oor:path="/org.openoffice.Office.Writer/Layout/Other">
    <prop oor:name="MeasureUnit" oor:op="fuse">
      <value>8</value>
    </prop>
  </item>
  <!-- Extra spacing between Asian and Western characters can push lines and
       change pagination vs Microsoft Word. -->
  <item oor:path="/org.openoffice.Office.Common/TextAutoSpacing">
    <prop oor:name="AsianOptions" oor:op="fuse">
      <value>false</value>
    </prop>
  </item>
  <!-- Embed common fonts in exported PDFs when possible. -->
  <item oor:path="/org.openoffice.Office.Common/Filter/PDF/Export">
    <prop oor:name="EmbedStandardFonts" oor:op="fuse">
      <value>true</value>
    </prop>
  </item>
</oor:items>
